<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionPointIdentifier</key>
		<!-- ⚠️ NOT `ManagedSettingsUI`. The two shield extension points live in
		     different namespaces: shield *configuration* is
		     com.apple.ManagedSettingsUI.shield-configuration-service, but shield
		     *action* is com.apple.ManagedSettings.shield-action-service. Getting
		     this wrong builds, signs and embeds cleanly — PluginKit simply never
		     matches the appex to a real extension point, so the delegate is never
		     invoked and both shield buttons are silently inert.
		     ShieldActionExtensionPointTests pins this string. -->
		<string>com.apple.ManagedSettings.shield-action-service</string>
		<key>NSExtensionPrincipalClass</key>
		<string>$(PRODUCT_MODULE_NAME).SkyShieldAction</string>
	</dict>
</dict>
</plist>
